{
  "name": "Deamon OTP Killer UI Design System",
  "version": "1.0.0",
  "grid": {
    "base": 8,
    "unit": "px"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "base": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "full": 9999
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "monoFontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "scale": {
      "display": { "size": "48px", "lineHeight": "1.1", "weight": 900, "letterSpacing": "-1.5px" },
      "largeTitle": { "size": "34px", "lineHeight": "1.15", "weight": 800, "letterSpacing": "-1.0px" },
      "title1": { "size": "28px", "lineHeight": "1.2", "weight": 800, "letterSpacing": "-0.75px" },
      "title2": { "size": "22px", "lineHeight": "1.25", "weight": 700, "letterSpacing": "-0.4px" },
      "headline": { "size": "17px", "lineHeight": "1.3", "weight": 600, "letterSpacing": "-0.2px" },
      "body": { "size": "16px", "lineHeight": "1.5", "weight": 400, "letterSpacing": "-0.1px" },
      "callout": { "size": "15px", "lineHeight": "1.45", "weight": 400, "letterSpacing": "0" },
      "subheadline": { "size": "14px", "lineHeight": "1.4", "weight": 400, "letterSpacing": "0" },
      "footnote": { "size": "13px", "lineHeight": "1.4", "weight": 400, "letterSpacing": "0" },
      "caption": { "size": "11px", "lineHeight": "1.3", "weight": 700, "letterSpacing": "0.8px", "textTransform": "uppercase" },
      "mono": { "size": "13px", "lineHeight": "1.4", "weight": 600, "letterSpacing": "0" }
    }
  },
  "color": {
    "dark": {
      "bg": "#090a0f",
      "surface": "#12131a",
      "surfaceElevated": "#181924",
      "border": "#1f202b",
      "borderSubtle": "#161720",
      "borderStrong": "#2d2f3d",
      "textPrimary": "#ffffff",
      "textSecondary": "#94a3b8",
      "textTertiary": "#64748b",
      "brand": "#7c3aed",
      "brandHover": "#6d28d9",
      "brandSoft": "rgba(124, 58, 237, 0.15)",
      "accent": "#38bdf8",
      "accentSoft": "rgba(56, 189, 248, 0.12)",
      "success": "#22c55e",
      "successSoft": "rgba(34, 197, 94, 0.12)",
      "warning": "#f59e0b",
      "warningSoft": "rgba(245, 158, 11, 0.12)",
      "danger": "#ef4444",
      "dangerSoft": "rgba(239, 68, 68, 0.12)"
    },
    "light": {
      "bg": "#f8fafc",
      "surface": "#ffffff",
      "surfaceElevated": "#f1f5f9",
      "border": "#e2e8f0",
      "borderSubtle": "#f1f5f9",
      "borderStrong": "#cbd5e1",
      "textPrimary": "#0f172a",
      "textSecondary": "#475569",
      "textTertiary": "#64748b",
      "brand": "#7c3aed",
      "brandHover": "#6d28d9",
      "brandSoft": "rgba(124, 58, 237, 0.08)",
      "accent": "#0284c7",
      "accentSoft": "rgba(2, 132, 199, 0.08)",
      "success": "#16a34a",
      "successSoft": "rgba(22, 163, 74, 0.08)",
      "warning": "#d97706",
      "warningSoft": "rgba(217, 119, 6, 0.08)",
      "danger": "#dc2626",
      "dangerSoft": "rgba(220, 38, 38, 0.08)"
    }
  },
  "elevation": {
    "dark": {
      "card": "0 1px 3px rgba(0, 0, 0, 0.4)",
      "modal": "0 20px 40px -15px rgba(0, 0, 0, 0.7)",
      "brandGlow": "0 8px 24px rgba(124, 58, 237, 0.25)"
    },
    "light": {
      "card": "0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04)",
      "modal": "0 20px 40px -15px rgba(0, 0, 0, 0.08)",
      "brandGlow": "0 8px 24px rgba(124, 58, 237, 0.2)"
    }
  }
}
